#!/usr/bin/env fish

function detect_monitors
    echo "Detecting monitors .."

    set -U MONITORS (
        ddcutil detect 2>/dev/null \
        | string match -rg '/dev/i2c-([0-9]+)'
    )

    if test (count $MONITORS) -eq 0
        echo "No monitors detected."
        echo "Make sure you're part of the i2c group and i2c-dev is loaded."
        exit 1
    end
end

function clear_cache
    echo "Clearing monitor cache .."
    set -eU MONITORS
end

set -l args $argv

if contains -- --clear $args
    clear_cache
    set args (string match -v -- --clear $args)
end

# `brightness --clear` should just clear and stop.
if test (count $args) -eq 0
    if contains -- --clear $argv
        exit 0
    end

    echo "Usage: brightness <percentage> [--clear]"
    exit 1
end

if not set -q MONITORS
    detect_monitors
end

set -l brightness $args[1]

if not string match -rq '^(100|[0-9]{1,2})$' -- $brightness
    echo "Brightness must be between 0 and 100."
    exit 1
end

for monitor in $MONITORS
    ddcutil --bus=$monitor setvcp 10 $brightness &
end

waitait
